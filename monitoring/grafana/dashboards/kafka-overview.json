{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["kafka"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "title": "Kafka Cluster Overview",
  "uid": "kafka-overview",
  "panels": [
    {
      "type": "stat",
      "title": "Brokers Online",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "count(count(kafka_brokers) by (instance)) or kafka_brokers", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Under-Replicated Partitions",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "expr": "sum(kafka_topic_partition_under_replicated_partition)", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Total Partitions",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(kafka_topic_partitions)", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Total Consumer Lag",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 100000 } ] } } },
      "targets": [ { "expr": "sum(kafka_consumergroup_lag)", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Consumer Lag by Group",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(kafka_consumergroup_lag) by (consumergroup)", "legendFormat": "{{consumergroup}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Message Rate by Topic (records/sec)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(rate(kafka_topic_partition_current_offset{topic!~\"__.*\"}[1m])) by (topic)", "legendFormat": "{{topic}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Under-Replicated Partitions (by topic)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(kafka_topic_partition_under_replicated_partition) by (topic)", "legendFormat": "{{topic}}", "refId": "A" } ]
    }
  ]
}
